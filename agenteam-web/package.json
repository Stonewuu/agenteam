{
  "name": "agenteam-web",
  "version": "0.2.0",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "eslint . --fix && prettier . --write",
    "format:check": "eslint . && prettier . --check",
    "test:i18n": "node --test tests/i18n.test.mjs",
    "test:conversation": "tsc -p tests/tsconfig.conversation.json && node --test tests/conversation-protocol.test.mjs",
    "test:completion-notice": "node --test tests/conversation-result-viewed.test.mjs",
    "test:workflow": "node --test tests/workflow-graph.test.mjs",
    "test:conversation-sidebar": "node --test tests/conversation-sidebar-layout.test.mjs tests/backend-proxy-range.test.mjs",
    "test:file-preview": "node --test tests/file-preview.test.mjs",
    "test:file-upload": "node --test tests/file-upload-paste.test.mjs",
    "test:forms": "node --test tests/form-errors.test.mjs",
    "test:channel-auth": "node --test tests/channel-access.test.mjs",
    "test:schedule-actions": "node --test tests/schedule-actions.test.mjs",
    "test:model-config": "node --test tests/model-token-length.test.mjs tests/model-selection.test.mjs",
    "test:tool-payload": "tsc src/features/plugin/lib/tool-payload-format.ts src/features/plugin/lib/tool-call-details.ts --target ES2022 --module commonjs --skipLibCheck --outDir .test-build/tool-payload && node --test tests/tool-payload.test.mjs tests/tool-call-details.test.mjs tests/tool-content-preview.test.mjs",
    "test:home-task": "node --test tests/home-task.test.mjs",
    "test:resource-deletion": "node --test tests/resource-deletion.test.mjs",
    "test:navigation": "node --test tests/navigation.test.mjs",
    "test:markdown": "tsc src/components/ui/markdown-animation-nodes.ts --target ES2022 --module commonjs --skipLibCheck --outDir .test-build/markdown-animation && node --test tests/markdown-animation.test.mjs"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.17",
    "@base-ui/react": "1.8.0",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@tiptap/core": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@xyflow/react": "^12.11.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "0.3.0",
    "iconsax-reactjs": "0.0.8",
    "next": "16.3.2",
    "ogl": "1.0.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "4.21.0",
    "streamdown": "^2.6.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@prettier/plugin-xml": "3.4.2",
    "@tailwindcss/postcss": "^4",
    "@types/hast": "3.0.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "prettier": "3.9.9",
    "tailwindcss": "^4",
    "typescript": "^5.1.3"
  },
  "packageManager": "pnpm@11.15.1"
}
