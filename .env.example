# 根目录可直接运行 docker compose up。需要自定义时，把本文件复制为根目录的 .env。
# PUBLIC_URL 留空时使用 http://localhost 和 HTTP_PORT；配置域名时填写用户访问的完整地址。
PUBLIC_URL=
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8088
FRONTEND_PORT=3000
BACKEND_PORT=8080

# 本机演示保留 container。正式 HTTPS 部署改成 container,production，并填写邮件设置。
SPRING_PROFILES_ACTIVE=container
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# 新装可留空，首次启动会自动生成并保存。已有数据卷请沿用原密码和凭据。
DB_PASSWORD=
DB_ROOT_PASSWORD=
REDIS_PASSWORD=
SANDBOX_TOKEN=
SETUP_CREDENTIAL=

# 有外层反向代理时，只填写该代理的实际来源地址，多个地址用空格分开；不信任任意客户端转发头。
TRUSTED_EDGE_PROXIES=
# 网页资料等外部内容需要访问内网时，填写具体来源地址；管理员配置的模型连接不使用此项。
ALLOWED_PRIVATE_ORIGINS=

# 通常无需修改。网段冲突时换用未占用的私有网段前缀，相关地址会一并变化。
COMPOSE_PROJECT_NAME=agenteam
NETWORK_PREFIX=172.29.44
# 常驻容器默认由主机管理内存。需要单独限制时填写 Docker 容量，例如 2g。
# MYSQL_MEMORY=
# BACKEND_MEMORY=
# FRONTEND_MEMORY=
# EXECUTOR_MEMORY=
MYSQL_IMAGE=docker.io/library/mysql:8
REDIS_IMAGE=docker.io/library/redis:7-alpine
GATEWAY_IMAGE=docker.io/library/nginx:1-alpine
# APP_IMAGE=
# FRONTEND_IMAGE=
# EXECUTOR_IMAGE=
# SANDBOX_IMAGE=
SANDBOX_MEMORY_MB=2048
SANDBOX_WORKSPACE_MB=512
SANDBOX_TEMPORARY_MB=256
SANDBOX_MAXIMUM_CONCURRENT=2
SANDBOX_TIMEOUT_SECONDS=1800
# 命令完整输出与项目文件分开保存；活跃任务引用的输出不会被自动清理。
COMMAND_RESULTS_RETENTION_DAYS=7
COMMAND_RESULTS_MAXIMUM_MB=256
COMMAND_RESULTS_MAXIMUM_ENTRIES=1000
# 需要浏览网页或 git clone 时可设为 bridge；none 保持禁用外网。也可填写已创建的专用 Docker 网络名称。
SANDBOX_NETWORK=none
SANDBOX_PROCESS_LIMIT=128

# 同时启用多个部署文件时，用逗号分隔路径。
COMPOSE_PATH_SEPARATOR=,
# 病毒扫描暂时关闭；恢复时同时设置开关和内部服务地址。
AGENTEAM_FILE_SCAN_ENABLED=false
AGENTEAM_FILE_SCAN_HOST=
AGENTEAM_FILE_SCAN_PORT=3310

# 升级期间可先关闭通知计划与外部发送，停止旧版本进程后再打开。
# 准备工作关闭会同时暂停新的智能体和通知操作准备；已提交的智能体执行仍由原执行器管理。
NOTIFICATION_ACTIONS_ENABLED=true
SCHEDULE_ACTION_WORKER_ENABLED=true
CHANNEL_DELIVERY_WORKER_ENABLED=true

# 岗位机器人在管理页面启停；企微必须使用专用智能机器人身份。
