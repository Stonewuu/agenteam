# 最常用的设置。先运行 configure.ps1 或 configure.sh 生成带随机密码的 .env。
# single：网页和接口共用 HTTP_PORT；split：网页与接口分别使用下面两个端口。
DEPLOY_MODE=single
PUBLIC_URL=http://localhost:8088
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8088
FRONTEND_PORT=3000
BACKEND_PORT=8080

# 本机演示保留 container。正式 HTTPS 部署改成 container,production，并填写邮件设置。
SPRING_PROFILES_ACTIVE=container
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# 初始化脚本分别生成这些值；不要提交实际配置文件，不要在已有数据卷上随意更换数据库密码。
DB_PASSWORD=
DB_ROOT_PASSWORD=
REDIS_PASSWORD=
SANDBOX_TOKEN=
SETUP_CREDENTIAL=

# 有外层反向代理时，只填写该代理的实际来源地址，多个地址用空格分开；不信任任意客户端转发头。
TRUSTED_EDGE_PROXIES=
# 需要连接本机模型服务时，填写具体地址，例如 http://host.docker.internal:11434。
ALLOWED_PRIVATE_ORIGINS=

# 通常无需修改。网段冲突时换用未占用的私有网段前缀，相关地址会一并变化。
COMPOSE_PROJECT_NAME=agenteam
NETWORK_PREFIX=172.29.44
BACKEND_MEMORY=2g
MYSQL_IMAGE=docker.io/library/mysql:8.4.11
REDIS_IMAGE=docker.io/library/redis:7.4.9-alpine
GATEWAY_IMAGE=docker.io/library/nginx:1.30.5-alpine
SANDBOX_IMAGE=agenteam/sandbox-office:local
SANDBOX_MEMORY_MB=2048
SANDBOX_WORKSPACE_MB=512
SANDBOX_TEMPORARY_MB=256
SANDBOX_MAXIMUM_CONCURRENT=2
SANDBOX_TIMEOUT_SECONDS=1800

# Compose 自动选择端口文件；使用逗号分隔，兼容 Windows、Linux 和 macOS。
COMPOSE_PATH_SEPARATOR=,
COMPOSE_FILE=compose.yaml,compose.${DEPLOY_MODE}.yaml
# 病毒扫描暂时关闭；恢复时同时设置开关和内部服务地址。
AGENTEAM_FILE_SCAN_ENABLED=false
AGENTEAM_FILE_SCAN_HOST=
AGENTEAM_FILE_SCAN_PORT=3310

# 升级期间可先关闭通知计划与外部发送，停止旧版本进程后再打开。
# 准备工作关闭会同时暂停新的智能体和通知操作准备；已提交的智能体执行仍由原执行器管理。
NOTIFICATION_ACTIONS_ENABLED=true
SCHEDULE_ACTION_WORKER_ENABLED=true
CHANNEL_DELIVERY_WORKER_ENABLED=true
