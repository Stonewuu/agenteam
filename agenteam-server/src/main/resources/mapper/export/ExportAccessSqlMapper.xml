<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.stonewu.agenteam.mapper.export.ExportAccessSqlMapper">
  <select id="visibleActors" resultType="String">
    SELECT m.user_id FROM enterprise_member m WHERE m.enterprise_id = #{scope.enterpriseId}
    AND
    <include refid="com.stonewu.agenteam.mapper.permission.ResourceScopeSqlMapper.owner">
      <property name="scopePath" value="scope"/>
      <property name="ownerColumn" value="m.user_id"/>
      <property name="enterpriseColumn" value="m.enterprise_id"/>
    </include>
    AND m.user_id IN
    <foreach collection="actors" item="actor" open="(" separator="," close=")">#{actor}</foreach>
  </select>
</mapper>
